<a href="#main-content" class="skip-to-content">Skip to main content</a>

<header>
  <div class="back-to-parliament">
    <div class="container">
      <a href="https://parliament.uhrblx.com/">
        <svg xmlns="http://www.w3.org/2000/svg" width="9" height="10" aria-hidden="true" focusable="false">
          <path fill="currentcolor" fill-rule="evenodd" d="M1.144 3.714 6.728.363A1.5 1.5 0 0 1 9 1.649v6.702a1.5 1.5 0 0 1-2.272 1.286l-5.584-3.35a1.5 1.5 0 0 1 0-2.573Z"/>
        </svg>
        <span>United Hampshire Parliament home</span>
      </a>
    </div>
  </div>

  <div class="banner">
    <div class="container">
      <% if content_for?(:message_banner) %>
        <div class="banner-message">
          <div class="banner-message__icon">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 22 22" aria-hidden="true" focusable="false">
              <path fill="currentColor" d="M11 0c6.075 0 11 4.925 11 11s-4.925 11-11 11S0 17.075 0 11 4.925 0 11 0m0 2a9 9 0 1 0 0 18 9 9 0 0 0 0-18m0 6a1 1 0 0 1 1 1v7a1 1 0 0 1-2 0V9a1 1 0 0 1 1-1m0-3a1 1 0 1 1 0 2 1 1 0 0 1 0-2"/>
            </svg>
          </div>
          <div class="banner-message__content">
            <div class="visually-hidden">Important</div>
            <%= content_for(:message_banner) %>
          </div>
        </div>
      <% end %>

      <a href="/" class="banner-logo" aria-label="Petitions — United Hampshire Parliament">
        <span class="uh-parliament-brand-crop"><img src="/uh-parliament-brand/uh-parliament-logo.png" alt="United Hampshire Parliament" width="1600" height="400" decoding="async"></span>
        <span class="banner-service-name">Petitions</span>
      </a>
    </div>
  </div>
</header>
