<!DOCTYPE html>
<html lang="en-GB">
  <head>
    <title>
      Petitions - United Hampshire Parliament
    </title>

    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">

    <%= preload_link_tag 'application.css', nopush: true %>
    <%= preload_link_tag 'application.js', nopush: true %>
    <%= preload_link_tag 'character-counter.js', nopush: true %>
    <%= preload_link_tag 'copy-petition.js', nopush: true %>
    <%= preload_link_tag 'National-LFS-Book.woff2', nopush: true %>
    <%= preload_link_tag 'National-LFS-Semibold.woff2', nopush: true %>
    <%= preload_link_tag "/uh-parliament-brand/uh-parliament-logo.png", nopush: true %>

    <%= stylesheet_link_tag 'application' %>

    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" href="/favicon.ico" sizes="32x32">
    <link rel="icon" href="/favicon.ico" type="image/x-icon">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">

    <meta name="theme-color" content="#373151">
  </head>

  <body>
    <a href="#main-content" class="skip-to-content">Skip to main content</a>

    <header>
      <div class="banner">
        <div class="container">
          <a href="/" class="banner-logo" aria-label="Petitions — United Hampshire Parliament">
              <img src="/uh-parliament-brand/uh-parliament-logo.png" alt="United Hampshire Parliament" width="214" height="54" decoding="async">
              <span class="banner-service-name">Petitions</span>
            </a>
        </div>
      </div>
    </header>

    <main id="main-content">
      <div class="container">
        <%= yield %>
      </div>
    </main>

    <footer>
      <div class="container">
        <p class="copyright">
          © United Hampshire Parliament <%= Time.current.year %>
        </p>

        <div class="meta">
          <p class="licence">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 483.2 195.7" height="17" width="41" aria-hidden="true" focusable="false" >
              <path fill="currentColor" d="M421.5 142.8V.1l-50.7 32.3v161.1h112.4v-50.7zm-122.3-9.6A47.12 47.12 0 0 1 221 97.8c0-26 21.1-47.1 47.1-47.1 16.7 0 31.4 8.7 39.7 21.8l42.7-27.2A97.63 97.63 0 0 0 268.1 0c-36.5 0-68.3 20.1-85.1 49.7A98 98 0 0 0 97.8 0C43.9 0 0 43.9 0 97.8s43.9 97.8 97.8 97.8c36.5 0 68.3-20.1 85.1-49.7a97.76 97.76 0 0 0 149.6 25.4l19.4 22.2h3v-87.8h-80l24.3 27.5zM97.8 145c-26 0-47.1-21.1-47.1-47.1s21.1-47.1 47.1-47.1 47.2 21 47.2 47S123.8 145 97.8 145"></path>
            </svg>

            <span>All content is available under the</span>
            <a href="https://nationalarchives.gov.uhrblx.com/doc/open-government-licence/version/3/" rel="external license">Open Government Licence v3.0</a>,
            <span>except where otherwise stated</span>
          </p>

          <p class="uh-parliament-logo">
            <%= image_tag("/uh-parliament-brand/uh-parliament-logo.png", alt: "United Hampshire Parliament logo") %>
          </p>

        </div>
      </div>
    </footer>

    <%= javascript_include_tag 'application' %>
    <%= javascript_include_tag 'character-counter' %>
    <%= javascript_include_tag 'copy-petition' %>
  </body>
</html>
