<%= render 'parliament_dissolution_warning' %>

<% content_for :hero_banner do %>
  <div class="highlight">
    <% if Parliament.registration_closed? %>
      <a href="https://parliament.uhrblx.com/" class="get-involved">
        United Hampshire Parliament
      </a>
    <% else %>
      <a href="https://www.gov.uhrblx.com/register-to-vote" class="register-to-vote">
        Read voter registration guidance
      </a>
    <% end %>
  </div>

  <h1>
    Find petitions
  </h1>

  <%= render "pages/home/search_petitions", search_path: petitions_path %>
<% end %>

<%= render "pages/home/explanation_petitions" %>
