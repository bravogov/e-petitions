<li id="debate">
  <%= time_tag(petition.scheduled_debate_date) do %>
    <strong><%= short_date_format(petition.scheduled_debate_date) %></strong>
  <% end %>

  <div>
    <h3>
      Parliament debated this petition
    </h3>

    <p>
      Information about the debate is available from the <a href="https://parliament.uhrblx.com/">United Hampshire Parliament website</a>, where published.
    </p>
  </div>
</li>
