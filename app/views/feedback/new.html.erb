<%= render 'parliament_dissolution_warning' %>

<% if Site.show_feedback_page_message? && !Parliament.dissolution_announced? %>
  <% content_for(:message_banner) { markdown_to_html(Site.feedback_page_message) } %>
<% end %>

<div class="grid-row margin-top-7">
  <div class="grid-column-two-thirds-from-laptop">
    <h1>
      Feedback and contact
    </h1>

    <h2>Feedback</h2>

    <%= form_for @feedback, url: feedback_path, html: {class: "wizard_form new_petition_form"} do |f| %>
      <%= form_row for: [@feedback, :comment] do %>
        <%= f.label :comment, "Comments" %>
        <%= error_messages_for_field @feedback, :comment %>
        <%= f.text_area :comment, rows: 5 %>
      <% end %>

      <%= form_row for: [@feedback, :petition_link_or_title] do %>
        <%= f.label :petition_link_or_title, class: "form-label" do %>
          Petition title/link <span class="optional">optional</span>
        <% end %>
        <%= error_messages_for_field @feedback, :petition_link_or_title %>
        <%= f.text_field :petition_link_or_title %>
      <% end %>

      <h3>Do you want a reply?</h3>

      <%= form_row for: [@feedback, :email] do %>
        <%= f.label :email, "Email address", class: "form-label" %>
        <%= error_messages_for_field @feedback, :email %>
        <%= f.text_field :email, inputmode: "email", autocomplete: "email" %>
      <% end %>

      <%= button_tag "Send feedback", class: "button" %>
    <% end -%>

  <div class="panel-indent">
    <p>
      We’ll only use your email to reply to your message
    </p>

    <p>
      We can’t forward your feedback to the people who started a petition
      or comment on the ideas raised in a specific petition
    </p>
  </div>

  <hr>

  <h2>Contact Parliament</h2>
  <p>For parliamentary enquiries, including questions about the Petitions Service,
    use the <a href="https://parliament.uhrblx.com/contact/">United Hampshire Parliament contact page</a>.
    This is separate from the feedback form above.</p>
  </div>
</div>
